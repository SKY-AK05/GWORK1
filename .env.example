# Copy to .env and fill only credentials you are authorized to use.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=DeepResearchAgent

# Select one model provider. Azure uses model azure/<deployment>.
AI_MODEL=azure/gpt-5.4-mini
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_AI_API_KEY=
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT=gpt-5.4-mini
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=60

# Search and registry credentials are separate from the AI key.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
COMPANIES_HOUSE_API_KEY=

# Bounded research controls.
MAX_RESEARCH_ROUNDS=5
MAX_SEARCHES_PER_ROUND=8
MAX_PAGES_PER_RUN=60
MAX_RETRIES=3
REPORT_OUTPUT_DIR=./reports

# Browser controls. Authenticated sessions require explicit user consent.
BROWSER_HEADLESS=false
BROWSER_PERSISTENT_SESSION=false
