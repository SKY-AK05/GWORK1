# Copy to .env and fill only the provider credentials you are authorized to use.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=DeepResearchAgent

# One LLM provider is required for planning and synthesis.
OPENROUTER_API_KEY=your-openrouter-key-here
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here

# Optional search providers. Leave empty to use the free DDGS fallback.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Optional authoritative UK registry verification.
COMPANIES_HOUSE_API_KEY=
