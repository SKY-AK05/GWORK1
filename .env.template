# Copy this file to `.env` and fill in your keys.

# =========================
# LangSmith tracing
# =========================
# Set to true to enable automatic tracing of all LangGraph / LangChain calls
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=DeepResearchAgent


# =========================
# OpenRouter (recommended)
# =========================
OPENROUTER_API_KEY=


# =========================
# OpenAI (optional)
# =========================
OPENAI_API_KEY=


# =========================
# Anthropic (optional)
# =========================
ANTHROPIC_API_KEY=


# =========================
# Google Gemini (optional)
# =========================
GOOGLE_API_KEY=


# =========================
# Web research backends
# =========================
# Search order: Tavily (primary) → Firecrawl (secondary) → DDGS (free fallback)
# A backend is skipped automatically if its key is missing or returns an error.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
